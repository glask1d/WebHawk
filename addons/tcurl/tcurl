body_is_text() {
  local ct
  if [[ ! -s "$tmp/body" ]]; then
    return 1
  fi
  # A NUL makes grep treat the file as binary. An empty pattern would match
  # everything, so detect that with -I instead of searching for NUL itself.
  if ! LC_ALL=C grep -qI . "$tmp/body"; then
    return 1
  fi
  ct=$(printf '%s' "$content_type" | tr '[:upper:]' '[:lower:]')
  case "$ct" in
    ""|text/*|application/json*|application/*xml*|application/javascript*|application/x-javascript*|application/*+json*|image/svg*)
      return 0 ;;
    *)
      return 1 ;;
  esac
}

show_result() {
  local view prompt page
  view=$tmp/view
  page=0

  {
    emit_identity
    emit_outcome
    if [[ -s "$tmp/body" ]] && body_is_text; then
      printf '\n'
      paint_body
    elif [[ -s "$tmp/body" ]]; then
      printf '\n'
      printf 'response kept off the terminal (%s, %s). save it with -o file\n' \
        "$(human_bytes "$size_download")" "${content_type:-unknown type}"
    fi
  } > "$view"

  page=0
  if [[ -s "$tmp/body" ]] && body_is_text && (( no_pager == 0 )) && [[ -t 1 ]] && command -v less >/dev/null 2>&1; then
    page=1
  fi

  if (( page )); then
    prompt='tcurl  line %lt-%lb of %L   space down   b up   q quit'
    env LESS= LESSHISTFILE=/dev/null \
      less --RAW-CONTROL-CHARS --quit-if-one-screen --no-init --tilde \
        --prompt="$prompt" "$view" || true
  elif [[ -t 1 ]]; then
    cat -- "$view"
  else
    cat -- "$view" >&2
  fi
}

main() {
  local cmd wfmt us start_s stream

  parse_args "$@"
  init_colors

  if (( url_count == 0 )); then
    printf '%stcurl:%s missing url\n' "$red" "$rst" >&2
    usage >&2
    exit 2
  fi
  if (( url_count > 1 )); then
    printf '%stcurl:%s pass one url\n' "$red" "$rst" >&2
    exit 2
  fi

  command -v torsocks >/dev/null 2>&1 || die "torsocks is not installed"
  command -v curl >/dev/null 2>&1 || die "curl is not installed"

  tmp=$(mktemp -d "${TMPDIR:-/tmp}/tcurl.XXXXXX") || die "couldn't create a temp directory"
  : > "$tmp/err"
  : > "$tmp/body"

  # One SOCKS identity for the check and the fetch, so both use one circuit.
  TORSOCKS_USERNAME=$(printf 'tc%04x%04x%04x' "$RANDOM" "$RANDOM" "$RANDOM")
  TORSOCKS_PASSWORD=$TORSOCKS_USERNAME
  export TORSOCKS_USERNAME TORSOCKS_PASSWORD

  progress " ${dim}looking up the tor exit...${rst}"
  if ! fetch_exit; then
    die "couldn't reach tor (is it listening on 127.0.0.1:9050?)" "$tmp/ip.err"
  fi
  style_exit

  if [[ "$istor" == false ]]; then
    progress_clear
    emit_identity >&2
    printf '  %s|%s %s%-7s%s %s%s%s\n' \
      "$red" "$rst" "$dim" "error" "$rst" \
      "$red" "tor check said this address is not on tor. request was not sent." "$rst" >&2
    exit 1
  fi

  stream=0
  if [[ ! -t 1 && -z "$user_out" && user_remote -eq 0 ]]; then
    stream=1
  fi

  cmd=(curl --silent --show-error)
  captured_body=0
  if (( user_w == 0 )); then
    us=$'\x1f'
    wfmt="%output{${tmp}/meta}%{http_code}${us}%{time_total}${us}%{size_download}${us}%{content_type}${us}%{url_effective}${us}%{filename_effective}"$'\n'
    cmd+=(-w "$wfmt")
  fi
  if (( user_dump == 0 )); then
    cmd+=(-D "$tmp/hdr")
  fi
  if (( stream == 0 && user_remote == 0 )) && [[ -z "$user_out" ]]; then
    cmd+=(-o "$tmp/body")
    captured_body=1
  fi
  cmd+=("${curl_args[@]}")

  if (( verbose || stream )); then
    progress_clear
    emit_identity >&2
  else
    progress " ${dim}exit${rst} ${bold}${ip}${rst}  ${dim}${tor_label}${rst}  ${dim}sending${rst}  ${url}"
  fi

  start_s=$SECONDS
  rc=0
  if (( stream )); then
    if (( verbose )); then
      torsocks "${cmd[@]}" || rc=$?
    else
      torsocks "${cmd[@]}" 2>"$tmp/err" || rc=$?
    fi
  else
    if (( verbose )); then
      user_w_out=$(torsocks "${cmd[@]}") || rc=$?
    else
      user_w_out=$(torsocks "${cmd[@]}" 2>"$tmp/err") || rc=$?
    fi
  fi
  elapsed=$((SECONDS - start_s))
  if (( verbose == 0 && stream == 0 )); then
    progress_clear
  fi
  load_meta

  if (( stream )); then
    emit_outcome >&2
    exit "$rc"
  fi

  show_result
  exit "$rc"
}

trap cleanup EXIT
trap on_int INT
trap on_int TERM
main "$@"
